## Tailwind Config สำเร็จรูปแต่ละ Theme

### ใส่ใน tailwind.config.ts:
```typescript
// Theme A: Dark Luxury
colors: {
  bg: { primary:'#080604', secondary:'#1a1612', card:'#2d2420' },
  gold: { DEFAULT:'#c9a96e', light:'#e8d5b0', dark:'#9a7a4a' },
  text: { primary:'#faf6f0', muted:'#b8a898', dim:'#6b5d52' },
}

// Theme B: Clean Academic
colors: {
  bg: { primary:'#f8fafc', secondary:'#f1f5f9', card:'#ffffff' },
  brand: { DEFAULT:'#3b82f6', light:'#dbeafe', dark:'#1d4ed8' },
  text: { primary:'#0f172a', muted:'#64748b', dim:'#94a3b8' },
}
```

