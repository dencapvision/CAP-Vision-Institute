## Scroll Animation (ใส่ทุก Demo)

```javascript
// Intersection Observer สำหรับ fade-in sections
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if(e.isIntersecting) {
      e.target.style.opacity = '1'
      e.target.style.transform = 'translateY(0)'
    }
  })
}, { threshold: 0.1 })

document.querySelectorAll('section').forEach(s => {
  s.style.cssText = 'opacity:0;transform:translateY(24px);transition:all .8s ease'
  observer.observe(s)
})
```

