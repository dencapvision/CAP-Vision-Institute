## lib/email.ts (เหมือนกันทุกโปรเจกต์)

```typescript
import { Resend } from 'resend'

const resend = new Resend(process.env.RESEND_API_KEY)

export async function sendNotification(subject: string, html: string) {
  return resend.emails.send({
    from: 'System <noreply@[domain].com>',
    to: [process.env.NOTIFICATION_EMAIL!],
    subject,
    html,
  })
}

export async function sendConfirmation(to: string, name: string, message: string) {
  return resend.emails.send({
    from: '[Business] <hello@[domain].com>',
    to: [to],
    subject: `ขอบคุณ ${name} — ได้รับข้อความแล้ว`,
    html: `<p>${message}</p>`,
  })
}
```

