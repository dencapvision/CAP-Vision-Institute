## Supabase Schema Template

```sql
-- ปรับ table names และ fields ตามธุรกิจ

-- Universal: Contacts / Inquiries
create table contact_inquiries (
  id           uuid primary key default gen_random_uuid(),
  name         text not null,
  phone        text not null,
  email        text,
  inquiry_type text,
  message      text,
  status       text default 'new',
  created_at   timestamptz default now()
);

-- Universal: Bookings / Appointments
create table bookings (
  id             uuid primary key default gen_random_uuid(),
  customer_name  text not null,
  phone          text,
  service_type   text,
  scheduled_at   timestamptz,
  status         text default 'pending',
  notes          text,
  created_at     timestamptz default now()
);

-- ธุรกิจ-specific tables (เพิ่มตาม category):
-- สถาบันติวเตอร์: courses, teachers, enrollments
-- คลินิก: patients, treatments, medical_records
-- ร้านอาหาร: menu_items, reservations, orders
-- Coaching: clients, programs, sessions

-- RLS Policies
alter table contact_inquiries enable row level security;
alter table bookings enable row level security;
create policy "Anyone can insert" on contact_inquiries for insert with check (true);
create policy "Anyone can insert booking" on bookings for insert with check (true);
```

