diff --git a/apps/cap-vision-astro/scripts/generate-sitemap.mjs b/apps/cap-vision-astro/scripts/generate-sitemap.mjs
new file mode 100644
index 0000000..eeef505
--- /dev/null
+++ b/apps/cap-vision-astro/scripts/generate-sitemap.mjs
@@ -0,0 +1,18 @@
+import {readFile, readdir, writeFile} from 'node:fs/promises';
+const root = new URL('../', import.meta.url);
+const basePaths = ['/', '/assessment', '/courses', '/services', '/portfolio', '/speakers', '/resources', '/about', '/contact'];
+const posts = await readdir(new URL('src/data/blog/posts/', root));
+const resources = [];
+for (const file of posts.filter(p => p.endsWith('.json')).sort()) {
+  const article = JSON.parse(await readFile(new URL(`src/data/blog/posts/${file}`, root), 'utf8'));
+  const publicCopy = await readFile(new URL(`public/content/blog/posts/${file}`, root), 'utf8');
+  if (JSON.stringify(JSON.parse(publicCopy)) !== JSON.stringify(article)) throw new Error(`Article copies differ: ${file}`);
+  if (!article.title) throw new Error(`Article has no title: ${file}`);
+  resources.push(`/resources/${encodeURIComponent(file.replace(/\.json$/, ''))}`);
+}
+const paths = [...new Set([...basePaths, ...resources])];
+const xml = `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${paths.map(path => `  <url><loc>https://capvisionpartner.com${path}</loc></url>`).join('\n')}\n</urlset>\n`;
+if (process.argv.includes('--check')) {
+  if (await readFile(new URL('public/sitemap.xml', root), 'utf8') !== xml) throw new Error('Sitemap is out of date');
+} else await writeFile(new URL('public/sitemap.xml', root), xml);
+console.log(`Sitemap checked: ${paths.length} URLs, ${resources.length} bundled articles`);
diff --git a/apps/cap-vision-astro/scripts/verify-release.mjs b/apps/cap-vision-astro/scripts/verify-release.mjs
new file mode 100644
index 0000000..863e7ab
--- /dev/null
+++ b/apps/cap-vision-astro/scripts/verify-release.mjs
@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+const arg = process.argv.find(a=>a.startsWith('--base='));
+if (!arg) throw new Error('Supply --base=https://your-staging-host (read-only HTTP check)');
+const base = new URL(arg.slice(7));
+if (!['http:', 'https:'].includes(base.protocol)) throw new Error('Invalid base URL');
+const checks = ['/', '/contact', '/services', '/resources/leader-as-facilitator'];
+const failures=[];
+for (const path of checks) {
+  try {
+    const response=await fetch(new URL(path,base),{signal:AbortSignal.timeout(15000)});
+    assert.equal(response.status,200, `${path}: HTTP ${response.status}`);
+    const html=await response.text();
+    assert.ok(html.includes(`rel="canonical" href="https://capvisionpartner.com${path}"`),`${path}: canonical mismatch`);
+    assert.ok(html.includes(`property="og:url" content="https://capvisionpartner.com${path}"`),`${path}: OG mismatch`);
+    if (path==='/') assert.ok(html.includes('อบรมองค์กร In-house Training พัฒนาผู้นำและทีม | CAP Vision Institute'), 'Homepage metadata is from an older build');
+    if (path.startsWith('/resources/')) assert.ok(!html.includes('กำลังโหลดเนื้อหา...'), 'Article is not rendered on server');
+    assert.ok(html.includes('การวัดผลเว็บไซต์'),'Consent interface is missing');
+    assert.ok(!html.includes('Error Log:'),'Raw error was exposed');
+    console.log(`PASS ${path}`);
+  } catch(e) { failures.push(e.message);console.error(`FAIL ${e.message}`); }
+}
+if(failures.length) process.exitCode=1;
