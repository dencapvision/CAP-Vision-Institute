{
  "name": "cap-vision-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-sitemap.mjs && astro build && node copy-wrangler.js",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && npx wrangler deploy --config dist/wrangler.json",
    "test": "node scripts/generate-sitemap.mjs --check && node --test tests/*.test.mjs",
    "typecheck:public": "tsc --noEmit -p tests/tsconfig.public.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "typescript": "^7.0.2"
  }
}
