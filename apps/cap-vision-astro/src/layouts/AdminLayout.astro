---
import Sidebar from '../components/admin/Sidebar.tsx';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Sarabun:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 font-sans">
    
    {/* Client-side auth verification */}
    <script>
      import { supabase } from '../lib/supabase';
      
      async function checkAuth() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session && window.location.pathname !== '/admin/login') {
          window.location.href = '/admin/login';
        }
      }
      
      checkAuth();
      
      // Keep checking on visibility changes
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          checkAuth();
        }
      });
    </script>

    <div class="min-h-screen flex flex-col lg:flex-row">
      <Sidebar client:load />
      <main class="flex-grow lg:pl-64 min-h-screen">
        <slot />
      </main>
    </div>
  </body>
</html>
