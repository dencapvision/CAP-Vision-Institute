---
interface Props {
	title?: string;
	description?: string;
}

const { 
  title = "CAP Vision Institute | สถาบันพัฒนาศักยภาพผู้นำและฝึกอบรมองค์กรครบวงจร",
  description = "สถาบันฝึกอบรมระดับพรีเมี่ยม พัฒนาศักยภาพผู้นำและทีมงานแบบครบวงจร ด้วย 6D CPS Model และ CAP Framework โดย ครูเด่น มาสเตอร์ฟา [Master Facilitator]"
} = Astro.props;

import Header from '../components/Header';
import Footer from '../components/Footer';
import FloatingLineWidget from '../components/FloatingLineWidget';
import '../styles/global.css';
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		
		<style is:global>
			body {
				font-family: 'Sarabun', sans-serif;
			}
			h1, h2, h3, h4, h5, h6, .nav-font {
				font-family: 'Prompt', sans-serif;
			}
		</style>
	</head>
	<body class="bg-[#f8fafc] text-[#1a202c] min-h-screen flex flex-col overflow-x-hidden">
		<Header client:load />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer client:visible />
		<FloatingLineWidget client:load />
	</body>
</html>
