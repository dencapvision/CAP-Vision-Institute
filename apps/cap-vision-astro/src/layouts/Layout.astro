---
interface Props {
	title?: string;
	description?: string;
}

const { 
  title = "CAP Vision Institute | Transform People, Transform Organization",
  description = "สถาบันพัฒนาศักยภาพผู้นำและฝึกอบรมครบวงจร โดย ครูเด่น มาสเตอร์ฟา [Master Facilitator]"
} = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		
		<style is:global>
			body {
				font-family: 'Sarabun', sans-serif;
			}
			h1, h2, h3, h4, h5, h6, .nav-font {
				font-family: 'Prompt', sans-serif;
			}
		</style>
	</head>
	<body class="bg-[#f8fafc] text-[#1a202c] min-h-screen flex flex-col">
		<slot />
	</body>
</html>
