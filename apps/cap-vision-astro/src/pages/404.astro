---
import Layout from '../layouts/Layout.astro';

// SSR for dynamic route fallbacks
export const prerender = false;
---

<Layout title="ไม่พบหน้า | CAP Vision Institute" description="ขออภัย ไม่พบหน้าที่คุณต้องการในระบบ">
  <div class="min-h-[80vh] bg-gray-50 flex items-center justify-center p-6 pt-28">
    <div class="text-center bg-white p-12 md:p-20 rounded-[3rem] shadow-2xl max-w-2xl border border-gray-100/50 relative overflow-hidden group">
      {/* Background Accent */}
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-blue-50/50 rounded-full blur-3xl pointer-events-none" />
      
      <div class="w-24 h-24 bg-amber-50 text-amber-500 rounded-3xl flex items-center justify-center mx-auto mb-10 shadow-lg border border-amber-100/50">
        <span class="text-5xl font-black nav-font">?</span>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-black text-[#0f3460] mb-6 nav-font leading-tight tracking-tighter">
        ขออภัย ไม่พบหน้าที่คุณต้องการ
      </h1>
      
      <div class="w-16 h-1 bg-[#c5a059] rounded-full mx-auto mb-8" />
      
      <p class="text-gray-500 mb-12 text-lg font-medium leading-relaxed max-w-lg mx-auto">
        หน้าที่คุณกำลังเข้าถึงอาจไม่มีอยู่ในระบบ หรือกำลังอยู่ในกระบวนการปรับปรุงย้ายระบบใหม่ครับ
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a 
          href="/" 
          class="bg-[#0f3460] text-white hover:bg-[#c5a059] px-10 py-5 rounded-2xl font-black nav-font tracking-widest text-sm shadow-xl hover:scale-105 active:scale-95 transition-all cursor-pointer"
        >
          กลับหน้าหลัก
        </a>
        <a 
          href="/courses" 
          class="border-2 border-gray-200 text-gray-500 hover:border-[#0f3460] hover:text-[#0f3460] px-10 py-5 rounded-2xl font-black nav-font tracking-widest text-sm hover:scale-105 active:scale-95 transition-all cursor-pointer"
        >
          ดูหลักสูตรทั้งหมด
        </a>
      </div>
    </div>
  </div>
</Layout>
