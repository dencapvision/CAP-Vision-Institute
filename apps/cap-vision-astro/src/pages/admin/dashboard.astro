---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { 
  FileText, Users, BookOpen, Calendar, 
  MessageSquare, Image, TrendingUp, Clock 
} from 'lucide-react';

// Enable server SSR
export const prerender = false;

let stats = {
  totalContents: 0,
  publishedContents: 0,
  totalSpeakers: 0,
  totalCourses: 0,
  totalEvents: 0,
  totalLeads: 0,
  newLeads: 0,
  totalMedia: 0
};

let recentLeads = [];
let recentContents = [];
let errorMsg = null;

try {
  const [
    totalContentsRes,
    publishedContentsRes,
    totalSpeakersRes,
    totalCoursesRes,
    totalEventsRes,
    totalLeadsRes,
    newLeadsRes,
    totalMediaRes
  ] = await Promise.all([
    supabase.from('blog_articles').select('*', { count: 'exact', head: true }),
    supabase.from('blog_articles').select('*', { count: 'exact', head: true }).eq('is_published', true),
    supabase.from('instructors').select('*', { count: 'exact', head: true }),
    supabase.from('courses').select('*', { count: 'exact', head: true }),
    supabase.from('events').select('*', { count: 'exact', head: true }),
    supabase.from('leads').select('*', { count: 'exact', head: true }),
    supabase.from('leads').select('*', { count: 'exact', head: true }).eq('status', 'new'),
    supabase.from('media').select('*', { count: 'exact', head: true })
  ]);

  stats = {
    totalContents: totalContentsRes.count || 0,
    publishedContents: publishedContentsRes.count || 0,
    totalSpeakers: totalSpeakersRes.count || 0,
    totalCourses: totalCoursesRes.count || 0,
    totalEvents: totalEventsRes.count || 0,
    totalLeads: totalLeadsRes.count || 0,
    newLeads: newLeadsRes.count || 0,
    totalMedia: totalMediaRes.count || 0
  };

  const { data: leadsData } = await supabase.from('leads').select('*').order('created_at', { ascending: false }).limit(5);
  recentLeads = leadsData || [];

  const { data: contentsData } = await supabase.from('blog_articles').select('id, title, is_published, slug, created_at').order('created_at', { ascending: false }).limit(5);
  recentContents = contentsData || [];
} catch (err: any) {
  console.error('[Admin Dashboard] SSR data fetch error:', err);
  errorMsg = err.message || err;
}

const statCards = [
  { label: 'เนื้อหาทั้งหมด', val: stats.totalContents, icon: FileText, color: 'text-blue-600', bg: 'bg-blue-50 border-blue-100', href: '/admin/contents' },
  { label: 'เผยแพร่แล้ว', val: stats.publishedContents, icon: TrendingUp, color: 'text-green-600', bg: 'bg-green-50 border-green-100', href: '/admin/contents?status=published' },
  { label: 'วิทยากร', val: stats.totalSpeakers, icon: Users, color: 'text-purple-600', bg: 'bg-purple-50 border-purple-100', href: '/admin/speakers' },
  { label: 'หลักสูตร', val: stats.totalCourses, icon: BookOpen, color: 'text-orange-600', bg: 'bg-orange-50 border-orange-100', href: '/admin/courses' },
  { label: 'อีเวนท์', val: stats.totalEvents, icon: Calendar, color: 'text-pink-600', bg: 'bg-pink-50 border-pink-100', href: '/admin/events' },
  { label: 'Leads ใหม่', val: stats.newLeads, icon: MessageSquare, color: 'text-red-600', bg: 'bg-red-50 border-red-100', href: '/admin/leads' },
  { label: 'Media ไฟล์', val: stats.totalMedia, icon: Image, color: 'text-teal-600', bg: 'bg-teal-50 border-teal-100', href: '/admin/media' },
];

const statusColor: Record<string, string> = {
  published: 'bg-green-100 text-green-700',
  draft: 'bg-gray-100 text-gray-600',
  archived: 'bg-yellow-100 text-yellow-700',
};

const leadStatusColor: Record<string, string> = {
  new: 'bg-red-100 text-red-700',
  contacted: 'bg-blue-100 text-blue-700',
  qualified: 'bg-green-100 text-green-700',
  closed: 'bg-gray-100 text-gray-600',
};
---

<AdminLayout title="Dashboard — CAP Vision Admin">
  <div class="p-6 lg:p-8 max-w-[1400px] mx-auto">
    {/* Header */}
    <div class="mb-8">
      <h1 class="text-2xl font-black text-gray-900">Dashboard</h1>
      <p class="text-gray-500 text-sm mt-1">ภาพรวมระบบ CAP Vision Admin CMS</p>
    </div>

    {errorMsg && (
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-8 text-sm">
        <p class="font-bold">Error loading dashboard data:</p>
        <p>{errorMsg}</p>
      </div>
    )}

    {/* Stats Grid */}
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4 mb-8">
      {statCards.map(({ label, val, icon: Icon, color, bg, href }) => (
        <a href={href} class={`${bg} border rounded-2xl p-4 hover:shadow-md transition-all hover:-translate-y-0.5 group`}>
          <div class={`${color} mb-3`}>
            <Icon className="w-5 h-5" />
          </div>
          <p class="text-2xl font-black text-gray-900">{val}</p>
          <p class="text-xs text-gray-500 mt-1 leading-tight">{label}</p>
        </a>
      ))}
    </div>

    {/* Quick actions */}
    <div class="flex flex-wrap gap-3 mb-8">
      <a href="/admin/contents/new?type=article"
        class="inline-flex items-center gap-2 bg-[#0f3460] text-white px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-[#0f3460]/90 transition-all shadow-sm">
        <FileText className="w-4 h-4" /> + บทความใหม่
      </a>
      <a href="/admin/speakers/new"
        class="inline-flex items-center gap-2 bg-[#c5a059] text-white px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-[#c5a059]/90 transition-all shadow-sm">
        <Users className="w-4 h-4" /> + วิทยากรใหม่
      </a>
      <a href="/admin/courses/new"
        class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 px-4 py-2.5 rounded-xl text-sm font-semibold hover:border-gray-300 transition-all shadow-sm">
        <BookOpen className="w-4 h-4" /> + หลักสูตรใหม่
      </a>
      <a href="/admin/events/new"
        class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 px-4 py-2.5 rounded-xl text-sm font-semibold hover:border-gray-300 transition-all shadow-sm">
        <Calendar className="w-4 h-4" /> + อีเวนท์ใหม่
      </a>
    </div>

    {/* Two-column bottom */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {/* Recent contents */}
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
          <h2 class="font-bold text-gray-800 flex items-center gap-2">
            <Clock className="w-4 h-4 text-gray-400" /> เนื้อหาล่าสุด
          </h2>
          <a href="/admin/contents" class="text-xs text-[#0f3460] font-medium hover:underline">ดูทั้งหมด</a>
        </div>
        <div class="divide-y divide-gray-50">
          {recentContents.length === 0 && (
            <p class="px-6 py-8 text-center text-gray-400 text-sm">ยังไม่มีเนื้อหา</p>
          )}
          {recentContents.map(c => (
            <a href={`/admin/contents/${c.id}`}
              class="flex items-center gap-3 px-6 py-3.5 hover:bg-gray-50 transition-colors group">
              <FileText className="w-4 h-4 text-gray-300 flex-shrink-0" />
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-800 truncate group-hover:text-[#0f3460]">{c.title}</p>
                <p class="text-xs text-gray-400">{c.content_type}</p>
              </div>
              <span class={`text-xs px-2 py-1 rounded-lg ${statusColor[c.status ?? 'draft'] ?? 'bg-gray-100 text-gray-600'}`}>
                {c.status}
              </span>
            </a>
          ))}
        </div>
      </div>

      {/* Recent leads */}
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
          <h2 class="font-bold text-gray-800 flex items-center gap-2">
            <MessageSquare className="w-4 h-4 text-gray-400" /> Leads ล่าสุด
            {stats.newLeads > 0 && (
              <span class="bg-red-500 text-white text-xs px-2 py-0.5 rounded-full font-bold">
                {stats.newLeads} ใหม่
              </span>
            )}
          </h2>
          <a href="/admin/leads" class="text-xs text-[#0f3460] font-medium hover:underline">ดูทั้งหมด</a>
        </div>
        <div class="divide-y divide-gray-50">
          {recentLeads.length === 0 && (
            <p class="px-6 py-8 text-center text-gray-400 text-sm">ยังไม่มี leads</p>
          )}
          {recentLeads.map(lead => (
            <div class="flex items-center gap-3 px-6 py-3.5">
              <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
                <span class="text-xs font-bold text-gray-500">{lead.name?.charAt(0) ?? '?'}</span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-800 truncate">{lead.name ?? 'ไม่ระบุ'}</p>
                <p class="text-xs text-gray-400 truncate">{lead.company || lead.email || '-'}</p>
              </div>
              <span class={`text-xs px-2 py-1 rounded-lg ${leadStatusColor[lead.status ?? 'new'] ?? 'bg-gray-100 text-gray-600'}`}>
                {lead.status}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
