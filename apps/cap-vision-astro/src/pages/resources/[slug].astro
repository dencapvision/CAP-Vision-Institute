---
import Layout from '../../layouts/Layout.astro';
import BlogArticleDetailPage from '../../components/BlogArticleDetailPage';

export const prerender = false;
const { slug } = Astro.params;
const decodedSlug = decodeURIComponent(slug || '');
---

<Layout title="CAP Vision Insight" description="สถาบันพัฒนาศักยภาพผู้นำและฝึกอบรมครบวงจร">
  <BlogArticleDetailPage client:load slug={decodedSlug} />
</Layout>
