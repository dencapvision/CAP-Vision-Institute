{
  "include": [
    "*.ts",
    "*.tsx",
    "components/**/*",
    "pages/**/*",
    "lib/**/*",
    "services/**/*",
    "packages/**/*",
    "scripts/**/*",
    "www/**/*"
  ],
  "exclude": [
    "cap-vision-admin",
    "node_modules",
    "dist",
    "supabase"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@kru-den/core": [
        "./packages/core/src/index.ts"
      ],
      "@kru-den/core/*": [
        "./packages/core/src/*"
      ],
      "@kru-den/database": [
        "./packages/database/src/index.ts"
      ],
      "@kru-den/integrations": [
        "./packages/integrations/src/index.ts"
      ],
      "@kru-den/integrations/*": [
        "./packages/integrations/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
